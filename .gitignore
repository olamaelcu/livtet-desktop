.DS_Store
node_modules
crates/livtet-desktop/binaries/
crates/livtet-desktop/target/
/build
/.svelte-kit
/package
/target
/.worktree
.env
.env.*
!.env.example
!.envrc.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Generated by tauri-specta — recreated on each debug build
web/lib/bindings.ts

# Coverage reports — regenerated by `mise run coverage` (ADR 38)
coverage/

# Biome — local cache, ignore shim
.biome/
*.biome.json~

# SOPS / secrets (mirrors mobile/.gitignore:20-24)
.mise/secrets.json
.mise/secrets.env
.mise/.sops-age-key-fingerprint
age.key
# Ignore everything under docs/superpowers EXCEPT the tracked specs subtree.
docs/superpowers/*
test-results/

.superpowers/
.claude
doc/superpowers/
.claude
prototype/

# Staged by scripts/stage-pdfjs.mjs — recreated on each dev/build (ADR 0037)
static/pdfjs/

# Flatpak staging, build dir, and OSTree repo (ADR 0039)
/packaging/flatpak/staging/
/flatpak-repo/
/build-dir/
.vitest

# Vendored crates.io sources referenced from `[patch.crates-io]` in Cargo.toml.
# Committed, not gitignored or submoduled: CI checks out tags without
# submodules, so a path dependency here must exist in the tree or the build
# cannot even resolve the workspace.
vendor/*
!vendor/atrium-oauth/
!vendor/tauri-plugin-deep-link/
!vendor/wmi/
