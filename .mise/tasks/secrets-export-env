#!/usr/bin/env bash
# secrets-export-env — Convert the decrypted JSON to .mise/secrets.env.
#
# Mobile's version (mobile/.mise/tasks/secrets-export-env:21-30) emits
# LIVTET_*-prefixed names with platform suffixes. We intentionally diverge
# here: desktop has no platform axis, no project namespace, and the
# consumers (tauri/build.rs) need direct names.
#
# Keys are lowercase so the file source and the env source in the config
# crate land on the same Map<String, Value> key when deserialized.
#
#MISE sources=[".mise/secrets.json", ".mise/tasks/secrets-export-env"]
#MISE outputs=[".mise/secrets.env"]

set -euo pipefail

readonly DECRYPTED=".mise/secrets.json"
readonly ENV_FILE=".mise/secrets.env"

if [[ ! -f "${DECRYPTED}" ]]; then
    echo "error: ${DECRYPTED} not found; run 'mise run secrets-decrypt' first" >&2
    exit 1
fi

export_value() {
    local name="$1"
    local jq_path="$2"
    local value
    value=$(jq -r "${jq_path} // \"\"" "${DECRYPTED}")
    printf '%s=%s\n' "${name}" "$(jq -nr --arg v "${value}" '$v | @sh')"
}

{
    export_value google_books_api_key '.api_keys.google.books'
    export_value sentry_dsn           '.telemetry.sentry.desktop.dsn'
} > "${ENV_FILE}"

echo "==> wrote ${ENV_FILE}"