#!/usr/bin/env bash
set -euo pipefail

python3 << 'PY'
import json, os, sys
try:
    with open("check-dupes.json") as f:
        report = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    report = {"items": []}

count = len(report.get("items", []))
items = report.get("items", [])[:5]

with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as f:
    f.write(f"## Code Duplication Report\n")
    f.write(f"Found **{count}** copy-paste families with 15+ duplicate lines\n\n")
    if items:
        f.write(f"### Top {len(items)} Findings\n")
        for i, item in enumerate(items, 1):
            files = item.get('files', [])
            m = item.get('metrics', {})
            f.write(f"{i}. `{files[0] if files else 'unknown'}` // {m.get('value', 'unknown')} tokens\n")

print(f"Found {count} duplication families")
if count > 0:
    sys.exit(1)
PY