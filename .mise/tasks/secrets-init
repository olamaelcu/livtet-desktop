#!/usr/bin/env bash
# secrets-init — Bootstrap a fresh desktop SOPS setup.
#
# What this does:
#   1. Generate an age keypair at ./age.key if absent (private + public).
#   2. Rewrite the desktop .sops.yaml with the real age recipient.
#   3. Encrypt .mise/secrets.json into .mise/secrets.json.sops.
#
# WARNING: This is maintainer-only. Running it on an existing setup
# will overwrite .sops.yaml and re-encrypt the bundle, which orphans
# every developer who already has the old key.
#
# Reference: mobile/.mise/tasks/secrets-init

set -euo pipefail

readonly SOPS_FILE=".sops.yaml"
readonly SOPS_BUNDLE=".mise/secrets.json.sops"
readonly PLAINTEXT=".mise/secrets.json"
readonly AGE_KEY="age.key"

if [[ ! -f "${AGE_KEY}" ]]; then
    echo "==> generating age keypair at ${AGE_KEY}"
    age-keygen -o "${AGE_KEY}" 2>&1
fi

RECIPIENT=$(age-keygen -y "${AGE_KEY}" 2>/dev/null)
if [[ -z "${RECIPIENT}" ]]; then
    echo "error: could not derive age recipient from ${AGE_KEY}" >&2
    exit 1
fi

cat > "${SOPS_FILE}" <<EOF
---
creation_rules:
  - path_regex: \\.mise/secrets\\.json\\.sops\$
    age: "${RECIPIENT}"
EOF

echo "==> wrote ${SOPS_FILE} with age recipient ${RECIPIENT:0:24}..."

if [[ ! -f "${PLAINTEXT}" ]]; then
    mkdir -p "$(dirname "${PLAINTEXT}")"
    cat > "${PLAINTEXT}" <<'JSON'
{
  "api_keys": {
    "google": {
      "books": ""
    }
  },
  "telemetry": {
    "sentry": {
      "desktop": {
        "dsn": ""
      }
    }
  }
}
JSON
    echo "==> wrote empty ${PLAINTEXT}; edit it with secrets-edit then re-encrypt"
    exit 0
fi

echo "==> encrypting ${PLAINTEXT} → ${SOPS_BUNDLE}"
sops --encrypt --in-place "${PLAINTEXT}"
mv "${PLAINTEXT}" "${SOPS_BUNDLE}"
echo "==> done. share ${AGE_KEY} (private) ONLY through secure channels."