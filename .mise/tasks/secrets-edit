#!/usr/bin/env bash
# secrets-edit — Edit the encrypted SOPS bundle in place.
#
# Opens .mise/secrets.json.sops via sops, which decrypts to a temp
# file, hands it to $EDITOR, then re-encrypts when the editor exits
# cleanly. Exit code 200 means "editor opened but contents unchanged"
# and is treated as success.
#
# Reference: mobile/.mise/tasks/secrets-edit

set -euo pipefail

if [[ -z "${SOPS_AGE_KEY:-}" && -z "${SOPS_AGE_KEY_FILE:-}" ]]; then
    echo "error: SOPS_AGE_KEY or SOPS_AGE_KEY_FILE must be set" >&2
    exit 1
fi

if [[ -z "${EDITOR:-}" ]]; then
    echo "error: EDITOR must be set (e.g. export EDITOR=vi)" >&2
    exit 1
fi

STATUS=0
sops --input-type json --output-type json --config .sops.yaml .mise/secrets.json.sops || STATUS=$?
if [[ ${STATUS} -eq 0 || ${STATUS} -eq 200 ]]; then
    exit 0
fi
exit ${STATUS}