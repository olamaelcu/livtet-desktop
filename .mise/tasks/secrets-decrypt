#!/usr/bin/env bash
# secrets-decrypt — Decrypt .mise/secrets.json.sops → .mise/secrets.json.
#
# Writes a fingerprint sentinel alongside the decrypted file so
# secrets-export-env can verify the keychain hasn't rotated since the
# last decrypt (sops doesn't track this itself).
#
# Reference: mobile/.mise/tasks/secrets-decrypt
#
#MISE sources=[".mise/secrets.json.sops", ".mise/.sops-age-key-fingerprint"]
#MISE outputs=[".mise/secrets.json"]

set -euo pipefail

readonly BUNDLE=".mise/secrets.json.sops"
readonly DECRYPTED=".mise/secrets.json"
readonly SENTINEL=".mise/.sops-age-key-fingerprint"

if [[ -z "${SOPS_AGE_KEY:-}" && -z "${SOPS_AGE_KEY_FILE:-}" ]]; then
    echo "error: SOPS_AGE_KEY or SOPS_AGE_KEY_FILE must be set" >&2
    exit 1
fi

if [[ ! -f "${BUNDLE}" ]]; then
    echo "error: ${BUNDLE} does not exist; run 'mise run secrets-init' first" >&2
    exit 1
fi

mkdir -p "$(dirname "${SENTINEL}")"

# Update the fingerprint sentinel so subsequent secrets-export-env runs
# can detect key rotation and re-derive.
printf '%s' "${SOPS_AGE_KEY:-$(cat "${SOPS_AGE_KEY_FILE}")}" \
    | shasum -a 256 \
    | awk '{print substr($1,1,16)}' \
    > "${SENTINEL}"

sops --decrypt --config .sops.yaml --output "${DECRYPTED}" "${BUNDLE}"
echo "==> decrypted to ${DECRYPTED}"