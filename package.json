{
  "name": "livtet-desktop",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "scripts": {
    "stage:pdfjs": "node scripts/stage-pdfjs.mjs",
    "dev": "pnpm stage:pdfjs && vite dev",
    "build": "pnpm stage:pdfjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "svelte-kit sync && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:browser": "playwright test --config e2e/playwright.config.ts --project=browser-only",
    "test:e2e:browser:ui": "playwright test --config e2e/playwright.config.ts --project=browser-only --ui",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "license": "MPL-2.0",
  "dependencies": {
    "@awesome.me/webawesome": "^3.10.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@olamaelcu/livtet-branding": "github:olamaelcu/livtet-branding#6f6ee01572c17987ae8138ee7a51e715c0fb2489",
    "@readium/css": "^2.0.5",
    "@readium/navigator": "^2.10.3",
    "@readium/navigator-html-injectables": "^2.8.3",
    "@readium/shared": "^2.5.1",
    "@tanstack/svelte-hotkeys": "^0.11.0",
    "@tanstack/svelte-query": "^6.2.4",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "pdfjs-dist": "^6.4.299",
    "svelte-sonner": "^0.3",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@hypothesi/tauri-mcp-cli": "^0.13.0",
    "@hypothesi/tauri-mcp-server": "^0.13.0",
    "@playwright/test": "^1.62.1",
    "@srsholmes/tauri-playwright": "^0.4.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tanstack/svelte-query-devtools": "^6.2.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "*",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "playwright": "^1.62.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "rolldown": "^1.2.0",
    "vitest": "^5.0.4",
    "vitest-browser-svelte": "^3.1.0"
  }
}
