{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "svelte": {
      "type": "remote",
      "url": "https://mcp.svelte.dev/mcp"
    },
    "tauri": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "--",
        "npx",
        "-y",
        "@hypothesi/tauri-mcp-server"
      ],
      "enabled": true
    },
    "taskwarrior": {
      "type": "local",
      "command": [
        "mise",
        "x",
        "--",
        "taskwarrior-mcp"
      ],
      "enabled": true
    }
  }
}